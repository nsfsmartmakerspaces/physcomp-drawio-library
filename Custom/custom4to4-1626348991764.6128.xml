<shape aspect="fixed" h="270" w="220" strokewidth="inherit" name="Custom 4 inputs, 4 outputs">
    <connections>
        <constraint x="0.5" y="0.0" perimeter="0" name="%top%"/>
        <constraint x="0.5" y="1.0" perimeter="0" name="%botom%"/>
        <constraint x="0.0" y="0.3333333333333333" perimeter="0" name="%input1%"/>
        <constraint x="0.0" y="0.4444444444444444" perimeter="0" name="%input2%"/>
        <constraint x="0.0" y="0.5555555555555556" perimeter="0" name="%input3%"/>
        <constraint x="0.0" y="0.6666666666666666" perimeter="0" name="%input4%"/>
        <constraint x="1.0" y="0.3333333333333333" perimeter="0" name="%output1%"/>
        <constraint x="1.0" y="0.4444444444444444" perimeter="0" name="%output2%"/>
        <constraint x="1.0" y="0.5555555555555556" perimeter="0" name="%output3%"/>
        <constraint x="1.0" y="0.6666666666666666" perimeter="0" name="%output4%"/>
    </connections>
    <background>
        <strokecolor color="#000000"/>
        <fillcolor color="#ffffff"/>
        <fontcolor color="#000000"/>
        <alpha alpha="1"/>
        <rect x="20" y="20" h="230" w="180" arcsize="-1"/>
        <fillstroke />
    </background>
    <foreground>
        <strokecolor color="#000000"/>
        <fillcolor color="#000000"/>
        <fontcolor color="#000000"/>
        <alpha alpha="1"/>
        <fontsize size="16"/>
        <text str="%name%" x="110.0" y="135.0" align="center" valign="middle" placeholders="1"/>
        <fontsize size="8"/>
        <text str="" x="196" y="248.0" align="right" valign="bottom" placeholders="1"/>
        <fontsize size="10"/>
        <path>
            <move x="110.0" y="0"/>
            <line x="110.0" y="20"/>
        </path>
        <fillstroke />
        <text str="%top%" x="110.0" y="33.0" align="center" valign="bottom" placeholders="1" />
        <path>
            <move x="110.0" y="270"/>
            <line x="110.0" y="250"/>
        </path>
        <fillstroke />
        <text str="%botom%" x="110.0" y="247.0" align="center" valign="bottom" placeholders="1" />
        <path>
            <move x="0" y="90.0"/>
            <line x="20" y="90.0"/>
        </path>
        <fillstroke />
        <text str="%input1%" x="24" y="90.0" align="left" valign="middle" placeholders="1" />
        <path>
            <move x="0" y="120.0"/>
            <line x="20" y="120.0"/>
        </path>
        <fillstroke />
        <text str="%input2%" x="24" y="120.0" align="left" valign="middle" placeholders="1" />
        <path>
            <move x="0" y="150.0"/>
            <line x="20" y="150.0"/>
        </path>
        <fillstroke />
        <text str="%input3%" x="24" y="150.0" align="left" valign="middle" placeholders="1" />
        <path>
            <move x="0" y="180.0"/>
            <line x="20" y="180.0"/>
        </path>
        <fillstroke />
        <text str="%input4%" x="24" y="180.0" align="left" valign="middle" placeholders="1" />
        <path>
            <move x="220" y="90.0"/>
            <line x="200" y="90.0"/>
        </path>
        <fillstroke />
        <text str="%output1%" x="196" y="90.0" align="right" valign="middle" placeholders="1" />
        <path>
            <move x="220" y="120.0"/>
            <line x="200" y="120.0"/>
        </path>
        <fillstroke />
        <text str="%output2%" x="196" y="120.0" align="right" valign="middle" placeholders="1" />
        <path>
            <move x="220" y="150.0"/>
            <line x="200" y="150.0"/>
        </path>
        <fillstroke />
        <text str="%output3%" x="196" y="150.0" align="right" valign="middle" placeholders="1" />
        <path>
            <move x="220" y="180.0"/>
            <line x="200" y="180.0"/>
        </path>
        <fillstroke />
        <text str="%output4%" x="196" y="180.0" align="right" valign="middle" placeholders="1" />
    </foreground>
</shape>
